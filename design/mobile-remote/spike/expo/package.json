{
  "name": "mobile-remote-spike-app",
  "private": true,
  "version": "0.0.1",
  "main": "index.js",
  "scripts": {
    "sync-vectors": "cp ../vectors.json ./vectors.json",
    "start": "npm run sync-vectors && expo start --dev-client",
    "typecheck": "tsc --noEmit",
    "config": "expo config --type public",
    "export:ios": "npm run sync-vectors && expo export --platform ios"
  },
  "dependencies": {
    "@noble/curves": "^1.9.0",
    "expo": "~54.0.0",
    "expo-dev-client": "~6.0.0",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-libsodium": "1.7.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.0"
  }
}
