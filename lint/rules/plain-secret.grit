// A secret file written straight to disk: a sign-in (auth.json), an API key, a token, a password or another credential
// saved by name with a plain write is readable by any process of the user and by every copy of the disk (backups).
// Save it with writeSecret in electron/secretFile.cjs (safeStorage, refused without the OS key), or through the
// store that owns it (identity/accounts/authVault.cjs for Codex sign-ins). It sees the file argument's text: a store
// writing an already-encrypted value to `this.file` is the store's own business, not this rule's.
// docs/bug-prevention/data-at-rest.md
language js

JsCallExpression() as $hit where {
  $hit <: or {
    `writePrivate($file, $...)`, `$_.writePrivate($file, $...)`,
    `writeAtomic($file, $...)`, `$_.writeAtomic($file, $...)`,
    `$_.writeFileSync($file, $...)`, `writeFileSync($file, $...)`,
    `$_.writeFile($file, $...)`, `writeFile($file, $...)`,
    `$_.appendFileSync($file, $...)`, `appendFileSync($file, $...)`,
    `$_.appendFile($file, $...)`, `appendFile($file, $...)`
  },
  $file <: r"(?is).*(?:auth\.json|api[-_]?key|token|secret|password|credential).*",
  register_diagnostic(span=$hit, message="[plain-secret] A secret written to disk as it is can be read by any process of the user and from every backup. Save it with writeSecret in electron/secretFile.cjs, or through the store that owns it (docs/bug-prevention/data-at-rest.md).", severity="warn")
}
