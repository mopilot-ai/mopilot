// A secret put on a child process's command line: any local process, another user's included, can list it (ps). The
// model relay's URL secret went to the Codex app-server as `-c openai_base_url=…/<secret>` (#2144). Send it over the
// child's stdin or a private file instead, or check the peer process (electron/relay.cjs admits). It sees a template
// literal or concatenation in the arguments that names a secret, token, password or API key.
// docs/bug-prevention/data-at-rest.md
language js

JsCallExpression() as $hit where {
  $hit <: or {
    `$_.spawn($cmd, $args, $...)`, `spawn($cmd, $args, $...)`,
    `$_.execFile($cmd, $args, $...)`, `execFile($cmd, $args, $...)`,
    `$_.execFileSync($cmd, $args, $...)`, `execFileSync($cmd, $args, $...)`,
    `spawnGroup($_, $cmd, $args, $...)`
  },
  $args <: contains or { JsTemplateExpression() as $t, JsBinaryExpression() as $t },
  $t <: r"(?is).*(?:secret|token|passw|api[-_]?key|apikey).*",
  register_diagnostic(span=$hit, message="[argv-secret] A secret on a child's command line can be read by any local process (ps). Send it over stdin or a private file, or check the peer process instead (docs/bug-prevention/data-at-rest.md).", severity="warn")
}
