{
  "id": "qwen",
  "label": "Qwen Code",
  "vendor": "Alibaba",
  "bins": [
    "qwen"
  ],
  "docsUrl": "https://qwenlm.github.io/qwen-code-docs/",
  "install": {
    "docs": "https://github.com/QwenLM/qwen-code",
    "methods": [
      {
        "via": "script",
        "command": "curl -fsSL https://qwen-code-assets.oss-cn-hangzhou.aliyuncs.com/installation/install-qwen-standalone.sh | bash",
        "os": [
          "darwin",
          "linux"
        ]
      },
      {
        "via": "brew",
        "command": "brew install qwen-code",
        "os": [
          "darwin",
          "linux"
        ],
        "needs": "brew",
        "brew": {
          "name": "qwen-code",
          "cask": false
        }
      },
      {
        "via": "npm",
        "command": "npm install -g @qwen-code/qwen-code@latest",
        "os": [
          "darwin",
          "linux",
          "win32"
        ],
        "needs": "node",
        "npm": "@qwen-code/qwen-code"
      },
      {
        "via": "powershell",
        "command": "irm https://qwen-code-assets.oss-cn-hangzhou.aliyuncs.com/installation/install-qwen-standalone.ps1 | iex",
        "os": [
          "win32"
        ]
      }
    ]
  },
  "enabled": true,
  "order": 4,
  "runtimeQuirks": true,
  "acp": {
    "env": {
      "QWEN_USAGE_STATISTICS_ENABLED": "false"
    },
    "args": [
      "--acp"
    ],
    "privacyDefaults": [
      "usage statistics (QWEN_USAGE_STATISTICS_ENABLED=false)"
    ],
    "admission": {
      "handshakeTimeoutMs": 10000
    },
    "anchors": {
      "plan": "readOnly",
      "default": "ask",
      "auto-edit": "auto",
      "auto": "auto",
      "yolo": "full"
    },
    "plan": {
      "mode": "plan"
    }
  },
  "instructionsFiles": [
    "QWEN.md",
    "AGENTS.md",
    "~/.qwen/QWEN.md"
  ],
  "contract": {
    "npm": "@qwen-code/qwen-code",
    "bin": "qwen"
  }
}
