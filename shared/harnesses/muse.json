  "enabled": true,
  "acp": {
    "args": [
      "acp"
    ],
    "env": {
      "MUSE_EXPERIMENTAL_ACP": "on"
    },
    "privacyDefaults": [],
    "admission": {
      "handshakeTimeoutMs": 10000,
      "requireResume": true
    }
  },
  "dataNotes": [
    "Native ACP integration.",
    "Muse ACP is experimental; its opt-in applies only to the MoPilot process."
  ]
}
