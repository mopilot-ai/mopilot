        const req = JSON.parse(line);
        buffer = buffer.slice(i + 1);
        if (req.method === 'host.hello') hello = true;
        if (!hello && VERSIONED_METHOD.test(req.method) && !BEFORE_HELLO.has(req.method)) {
          const refusal = new HelloRequiredError();
          note('refused', { method: req.method, code: refusal.code });
          say({ id: req.id, error: refusal.message, code: refusal.code });
          continue;
        }
        if (WIRE ? WIRE_METHOD(req.method) : process.env.FAKE_HOST_CHATS_SOCK && CHAT_METHODS.has(req.method)) {
          toResident(line);
          continue;
        }
        answer(req.method, req.params ?? {}, say).then((reply) => say({ id: req.id, ...reply }));
      }
    });
  })
  .listen(local);
// ssh -N stays up until the app stops it, or the machine is taken down
setInterval(exitIfOffline, 200);
