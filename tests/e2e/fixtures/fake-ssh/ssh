        result: {
          build: hostBuild(),
          ...(said()?.appVersion ? { appVersion: said().appVersion } : {}),
          harnesses: process.env.FAKE_HOST_HARNESSES ? JSON.parse(process.env.FAKE_HOST_HARNESSES) : [{ id: 'claude', detected: true, signedIn: true }],
          capabilities: process.env.FAKE_HOST_CAPS ? JSON.parse(process.env.FAKE_HOST_CAPS) : { shell: true },
