const forward = args[args.indexOf('-L') + 1];
const local = forward.slice(0, forward.lastIndexOf(':'));
const root = fs.realpathSync(process.env.FAKE_HOST_ROOT);
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

const dirs = (dir) =>
  fs
    .readdirSync(dir, { withFileTypes: true })
    .filter((e) => e.isDirectory() && !e.name.startsWith('.'))
    .map((e) => ({ name: e.name, path: path.join(dir, e.name), git: fs.existsSync(path.join(dir, e.name, '.git')) }))
    .sort((a, b) => a.name.localeCompare(b.name));

const note = (method, params) => process.env.FAKE_HOST_LOG && fs.appendFileSync(process.env.FAKE_HOST_LOG, `${JSON.stringify({ method, params })}\n`);
// the build `status` reports: FAKE_HOST_BUILD, else the app's own, so a machine is not called old unless a spec says so
let ownBuild;
const said = () => (process.env.FAKE_HOST_VERSIONS ? JSON.parse(process.env.FAKE_HOST_VERSIONS)[destination] : undefined);
const hostBuild = () => said()?.build ?? process.env.FAKE_HOST_BUILD ?? (ownBuild ??= require('../../../../electron/host/bundle.cjs').appHostBuild(path.join(__dirname, '../../../..')));
// FAKE_HOST_OLD_CLONE: a Host from before a clone could borrow the app's sign-in; FAKE_HOST_OLD_GIT_SIGNIN: one from before GitHub device sign-in; FAKE_HOST_OLD_FAMILIES: one from before a continue took Claude Code and Codex (no `continueFamilies`)
const FEATURES = ['epoch', 'dedupe', 'isolation', 'lanes', 'browser', 'stream2', 'gitWrite', ...(process.env.FAKE_HOST_OLD_GIT_SIGNIN ? [] : ['gitSignin']), ...(process.env.FAKE_HOST_OLD_FAMILIES ? [] : ['continueFamilies']), ...(process.env.FAKE_HOST_OLD_CLONE ? [] : ['cloneCredential']),
