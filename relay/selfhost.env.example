# Copy to selfhost.env, then set a unique database password and your account issuer before starting the relay.
POSTGRES_PASSWORD=
AUTH_ISSUER=

# Set exactly one verification source. Use the public key only, with literal \n in a PEM if it spans lines.
AUTH_JWKS_URL=
AUTH_PUBLIC_KEY=

# Keep push off until you configure APNs or FCM for your own build. See relay/README.md for settings.
PUSH_MODE=none
MAILBOX_TTL_DAYS=7
METRICS_TOKEN=
