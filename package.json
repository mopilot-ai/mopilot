{
  "name": "mopilot",
  "productName": "MoPilot",
  "version": "0.3.0",
  "private": true,
  "description": "MoPilot: a desktop home for coding agents",
  "homepage": "https://mopilot.ai",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.14.1",
  "main": "electron/boot.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node scripts/build-core.mjs --ensure && vite build && electron .",
    "lint": "node scripts/hook-check.mjs && biome lint --diagnostic-level=error && node scripts/lint-ratchet.mjs --base=origin/main",
    "lint:ratchet": "node scripts/lint-ratchet.mjs",
    "check:files": "node scripts/file-size.mjs",
    "i18n:check": "node scripts/i18n/check.mjs",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.node.json && node scripts/precommit.mjs --typecheck-mobile",
    "pretest": "node scripts/harness-catalog.mjs && node scripts/ensure-electron.cjs",
    "test": "node scripts/test-slots.mjs --no-maglev --test --test-global-setup=scripts/test-global-setup.mjs --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./scripts/test-file-failures.mjs --test-reporter-destination=stderr --experimental-test-module-mocks --import ./tests/support/register.ts --disable-warning=MODULE_TYPELESS_PACKAGE_JSON 'tests/**/*.test.ts'",
    "test:coverage": "node scripts/hook-check.mjs && node scripts/unit-coverage.mjs",
    "test:related": "node scripts/related-tests.mjs",
    "module-map": "node scripts/module-map.mjs",
    "test:diff-coverage": "node scripts/diff-coverage.mjs",
    "package": "vite build && node scripts/package.mjs",
    "package:win:dir": "vite build && node scripts/package.mjs --platform win32 --arch x64",
    "package:win": "npm run package:win:dir && node scripts/package-win.mjs --arch x64",
    "package:linux:dir": "vite build && node scripts/package.mjs --platform linux",
    "package:linux": "npm run package:linux:dir && node scripts/package-linux.mjs",
    "conformance": "node tests/conformance/run.mjs",
    "harness-matrix": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/gen-matrix.mjs",
    "third-party": "node scripts/gen-third-party.mjs",
    "format": "biome format --write",
    "build:chrome-extension": "node scripts/build-chrome-extension.mjs",
    "predev": "node scripts/harness-catalog.mjs",
    "prebuild": "node scripts/harness-catalog.mjs",
    "prestart": "node scripts/harness-catalog.mjs",
    "prepackage": "node scripts/harness-catalog.mjs",
    "pretypecheck": "node scripts/harness-catalog.mjs",
    "pretest:coverage": "node scripts/harness-catalog.mjs",
    "preharness-matrix": "node scripts/harness-catalog.mjs",
    "prepare": "node scripts/harness-catalog.mjs && (git config core.hooksPath .githooks && node scripts/hook-check.mjs || true) && (node scripts/module-map.mjs || true)"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@electric-sql/pglite": "^0.5.11",
    "@electron/fuses": "2.1.3",
    "@electron/packager": "^20.3.0",
    "@electron/rebuild": "4.2.1",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@office-kit/pptx": "0.27.0",
    "@office-kit/pptx-preview": "0.19.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "c8": "^12.0.0",
    "docx-preview": "0.4.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "0.28.2",
    "happy-dom": "^20.14.6",
    "jszip": "3.10.1",
    "katex": "^0.19.0",
    "lucide-react": "^1.53.0",
    "mdast-util-from-markdown": "2.1.0",
    "node-api-headers": "1.9.0",
    "pdfjs-dist": "6.4.299",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "rolldown": "1.2.13",
    "shiki": "^4.5.0",
    "sucrase": "3.35.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.295",
    "@googleapis/calendar": "20.2.0",
    "@googleapis/gmail": "22.1.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/mcp": "0.0.83",
    "@vscode/ripgrep": "1.18.0",
    "cfb": "1.2.2",
    "google-auth-library": "11.3.4",
    "js-yaml": "4.3.2",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm-autolink-literal": "2.0.1",
    "mdast-util-gfm-strikethrough": "2.0.1",
    "mdast-util-gfm-table": "2.0.0",
    "micromark-extension-cjk-friendly": "2.0.2",
    "micromark-extension-cjk-friendly-gfm-strikethrough": "2.0.1",
    "micromark-extension-gfm-autolink-literal": "2.1.0",
    "micromark-extension-gfm-table": "2.1.2",
    "node-pty": "1.1.0",
    "qrcode": "^1.5.4",
    "remark-breaks": "^4.0.0",
    "remark-cjk-friendly": "^2.3.2",
    "remark-cjk-friendly-gfm-strikethrough": "^2.3.1",
    "remark-parse": "^11.0.0",
    "rrule": "^2.8.1",
    "smol-toml": "^1.9.0",
    "sodium-native": "^5.2.0",
    "tldts": "7.4.19",
    "unified": "^11.0.5",
    "word-extractor": "1.0.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  }
}
